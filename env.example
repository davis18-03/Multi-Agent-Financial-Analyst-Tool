# Environment Variables Template for Multi-Agent Financial Analyst Tool
# Copy this file to .env and configure with your actual values

# =============================================================================
# LLM API CONFIGURATION
# =============================================================================

# OpenRouter API Key (recommended for cost-effective LLM access)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here

# Alternative: OpenAI API Key (if using OpenAI directly)
# OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Environment
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# =============================================================================
# LLM MODEL CONFIGURATION
# =============================================================================

# LLM Provider: openrouter, openai, huggingface, langchain, fallback
LLM_PROVIDER=openrouter

# Model name (for OpenRouter, use format: openai/gpt-3.5-turbo)
LLM_MODEL_NAME=openai/gpt-3.5-turbo

# LLM Parameters
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.3

# =============================================================================
# DATA CONFIGURATION
# =============================================================================

# Cache settings
CACHE_SIZE=128
REQUEST_TIMEOUT=30

# Vector store configuration
VECTOR_STORE_PATH=./vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chart configuration
CHART_SAVE_PATH=./charts

# =============================================================================
# NETWORKING CONFIGURATION
# =============================================================================

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8501,https://your-streamlit-app.onrender.com

# =============================================================================
# OPTIONAL: EXTERNAL API KEYS
# =============================================================================

# Financial data APIs (optional)
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# FINNHUB_API_KEY=your-finnhub-key

# =============================================================================
# BACKEND CONFIGURATION
# =============================================================================

# Backend URL for frontend
BACKEND_URL=http://localhost:8000

# =============================================================================
# STREAMLIT CONFIGURATION
# =============================================================================

# Streamlit settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
