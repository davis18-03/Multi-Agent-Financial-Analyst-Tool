# Streamlit Cloud secrets configuration
# Copy this file to .streamlit/secrets.toml for local development
# For Streamlit Cloud, add these as secrets in the dashboard

[api]
# Backend URL - update with your Render deployment URL
backend_url = "https://your-backend-name.onrender.com"

[openrouter]
# OpenRouter API Key for LLM functionality
api_key = "sk-or-v1-your-openrouter-api-key-here"

[openai]
# Alternative: OpenAI API Key (if using OpenAI directly)
api_key = "sk-your-openai-api-key-here"

[app]
# Application configuration
environment = "production"
log_level = "INFO"
