# Streamlit Secrets Configuration Template for Multi-Agent Financial Analyst Tool
# Copy this file to .streamlit/secrets.toml and configure with your actual values

# Backend API Configuration
BACKEND_URL = "http://localhost:8000"  # Replace with your FastAPI backend URL
# For production/Render deployment, use: "https://your-app-name.onrender.com"
# For Streamlit Cloud deployment, use your Render backend URL

# LLM API Configuration
# OpenRouter API Key (recommended for cost-effective LLM access)
OPENROUTER_API_KEY = "sk-or-v1-your-openrouter-api-key-here"

# Alternative: OpenAI API Key (if using OpenAI directly)
# OPENAI_API_KEY = "sk-your-openai-api-key-here"

# Optional: Other API keys for additional services
# ALPHA_VANTAGE_API_KEY = "your-alpha-vantage-key"
# FINNHUB_API_KEY = "your-finnhub-key"

# Streamlit Configuration
[theme]
primaryColor = "#667eea"
backgroundColor = "#ffffff"
secondaryBackgroundColor = "#f0f2f6"
textColor = "#262730"
font = "sans serif"

[server]
headless = true
port = 8501
enableCORS = false
enableXsrfProtection = false

[browser]
gatherUsageStats = false
